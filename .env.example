# Ключ корпоративного LiteLLM для платформенного провайдера чата.
# Скопируй файл в .env (он в .gitignore) и вставь RAW-токен в одну строку:
# без префикса Bearer, кавычек и пробелов. Qwen Base URL/модели уже заданы
# дефолтами agctl; эти переменные нужны только для переопределения.
#   cp .env.example .env
# После запуска ключ хранится зашифрованным в SQLite; .env можно убрать.
AGCTL_LLM_API_KEY=

# Опционально: свой провайдер/модели, make up подхватит из окружения.
#AGCTL_LLM_BASE_URL=https://litellm-dev.utmn.ru/v1
#AGCTL_LLM_MODELS=qwen-3.8-deep,qwen-3.8-27b,qwen-3.8-fast,qwen3guard,qwen3.5-9b-q8_0
#AGCTL_LLM_MODEL=qwen-3.8-fast
