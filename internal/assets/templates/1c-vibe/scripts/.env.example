# Настройки окружения для MVP 1c-vibe.
# Скопируй в mvp/.env и заполни. НИКОГДА не коммить .env.

# Jira (Server/DC): Personal Access Token из профиля пользователя
JIRA_URL=https://jira.example.local
JIRA_TOKEN=

# GitLab: Personal Access Token со scope api
GITLAB_URL=https://gitlab.example.local
GITLAB_TOKEN=

# Таймаут REST-запросов в секундах
HTTP_TIMEOUT_SECONDS=30

# Корпоративный CA-сертификат (PEM), если GitLab/Jira на self-signed.
# Получить можно из браузера: экспортировать цепочку в .pem.
# HTTPS_CA_BUNDLE=/path/to/corporate-ca.pem

# Совсем отключить проверку TLS (не рекомендуется, только для отладки)
# INSECURE_TLS=1

# Путь демо-проекта на GitLab (для подсказок, publish берёт его из git remote)
DEMO_PROJECT=rd/1c-ai/1c-vibe-demo
