# Ключ корпоративного LiteLLM для платформенного провайдера чата.
# Скопируй файл в .env (он в .gitignore и не коммитится) и впиши ключ:
#   cp .env.example .env
# После первого запуска ключ хранится зашифрованным в SQLite —
# при следующих стартах .env можно даже не заполнять.
AGCTL_LLM_API_KEY=

# Опционально: свой провайдер/модели (make up подхватит их из окружения).
# Без этих строк make corp использует дефолты из bin/run.mk.
#AGCTL_LLM_BASE_URL=https://litellm-dev.utmn.ru/v1
#AGCTL_LLM_MODELS=qwen-3.8-dee,qwen-3.8-27b,qwen-3.8-fast,qwen3guard,qwen3.5-9b-q8_0
#AGCTL_LLM_MODEL=qwen-3.8-fast
