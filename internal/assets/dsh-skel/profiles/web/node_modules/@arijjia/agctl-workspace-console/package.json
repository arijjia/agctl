{
  "name": "@arijjia/agctl-workspace-console",
  "description": "agctl workspace console: skills, tools and prompts per project, server-side toggles",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-layout"],
      "platform": "web"
    }
  }
}
