# Ключ основного провайдера (профиль задаёт эндпоинт и модели).
# Скопируй файл в .env (он в .gitignore) и вставь RAW-токен в одну строку:
# без префикса Bearer, кавычек и пробелов.
#   cp .env.example .env
# После запуска ключ хранится зашифрованным в SQLite; .env можно убрать.
AGCTL_LLM_API_KEY=

# Ключ второго провайдера — корпоративного LiteLLM (Qwen). Имя переменной
# задаётся в профиле (llm.extra_providers[].api_key_env), само значение — здесь.
AGCTL_LLM_CORP_API_KEY=

# Опционально: переопределить основной провайдер/модели из профиля.
#AGCTL_LLM_PROVIDER=zai-coding-cn
#AGCTL_LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
#AGCTL_LLM_MODELS=glm-5.3,glm-5.3-flash,glm-4.5-flash,glm-4.5v
#AGCTL_LLM_MODEL=glm-5.3-flash
