# agctl-dsh-min: минимальное рабочее место — node, git и dsh плюс guest
# agctl. Без офиса, CLI разработчика, kubectl и MCP-кэша: «чистый» dsh для
# проверки и основа для своих надстроек. Стадия base дословно совпадает с
# полным образом (Dockerfile) — слой берётся из общего кэша.
# Версию dsh передаёт сборщик (--build-arg DSH_VERSION): пин один — в
# Dockerfile полного образа, его читают make img_build и agctl.
FROM node:22-bookworm-slim AS base
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-pytest python3-pip make g++ ca-certificates curl git openssh-server iptables \
  && rm -rf /var/lib/apt/lists/* \
  && npm install -g npm@12 --no-audit --no-fund \
  && npm --version
# iptables — egress-allowlist: хелпер применения DOCKER-USER правил (egress.go);
# git нужен агенту в воркспейсе; npm>=11 ради allow-scripts (нативные депы dsh);
# python3+pytest+pip — тулзы доменных шаблонов (например 1c-vibe) и надстроек
# профилей: пакеты организации ставятся в её image/Dockerfile (FROM agctl-dsh).

FROM base AS runtime
ARG DSH_VERSION
RUN test -n "$DSH_VERSION" || { echo "нужен --build-arg DSH_VERSION (пин — в Dockerfile полного образа)"; exit 1; }
# идентичность git для агента (в любом репо контейнера)
RUN git config --system user.name "agent" \
  && git config --system user.email "agent@workspace.local" \
  && git config --system init.defaultBranch main \
  && git config --system --add safe.directory '*' \
  && npm config set allow-scripts \
      @deepseek-ai/dsh-subprocess-local,koffi,node-pty,fsevents,protobufjs,esbuild \
      --location=user \
  && npm install -g --no-audit --no-fund @deepseek-ai/dsh@${DSH_VERSION} \
  && dsh --version
ENV PATH="/opt/dsh/bin:${PATH}"
ENV DSH_HOME=/home/dsh
# Вариант образа «без SSH» (лаунчер developer'а): собирается с
# --build-arg AGCTL_NO_SSHD=1 (тег agctl-dsh-nossh:*) — entrypoint не поднимает
# sshd даже при переданном публичном ключе.
ARG AGCTL_NO_SSHD=0
ENV AGCTL_NO_SSHD=${AGCTL_NO_SSHD}
# Вариант guest-бинаря: local (bridge, по умолчанию — образ agctl-dsh*, локальный
# режим) | server (ax-runner + init-chat-home — образ agctl-dsh-server*, серверные
# рантаймы docker|k8s|ax). Бинарь кладёт сборщик: make img_build / img_build_server.
ARG GUEST_FLAVOR=local
COPY agctl /usr/local/bin/agctl
# Скелет DSH_HOME: entrypoint сеет его в пустой том (см. /opt/dsh-skel).
COPY skel/ /opt/dsh-skel/
COPY entrypoint.sh /usr/local/bin/agctl-entrypoint
COPY dsh-net.mjs /usr/local/bin/agctl-dsh-net
RUN chmod +x /usr/local/bin/agctl /usr/local/bin/agctl-entrypoint /usr/local/bin/agctl-dsh-net && mkdir -p /home/dsh /workspace
# Google AX / Agent Substrate: PID 1 песочницы — /usr/local/bin/ax-task-runner
# (контракт раннера AX); здесь это обёртка над `agctl ax-runner`: probes на
# :80, прокси на dsh web :3080, хвост лога запуска для шлюза. Только серверный
# вариант: в Docker/K8s не используется (ENTRYPOINT ниже), в локальном образе
# раннера нет — обёртку не создаём.
RUN if [ "$GUEST_FLAVOR" = "server" ]; then \
      printf '#!/bin/sh\nexec /usr/local/bin/agctl ax-runner "$@"\n' > /usr/local/bin/ax-task-runner && chmod +x /usr/local/bin/ax-task-runner; fi
WORKDIR /workspace
EXPOSE 3080 2222
# Живость dsh: любой HTTP-ответ (в т.ч. 401/303 без cookie) = процесс жив и
# слушает dsh web на eth0-адресе контейнера (agctl-dsh-net health); обрыв/
# таймаут/5xx = unhealthy. Start-period — с запасом на первый прогрев
# (MCP-кэш уже вшит). Статус читает agctl (reconcile).
HEALTHCHECK --interval=30s --timeout=6s --start-period=150s --retries=3 \
  CMD node /usr/local/bin/agctl-dsh-net health
ENTRYPOINT ["agctl-entrypoint"]

# Метки — последний слой метаданных: сборка agctl меняется каждый раз, а
# кэш слоёв выше не страдает. io.agctl.guest.api — уровень возможностей
# guest (2: presets-sync в entrypoint); лаунчер сверяет его со своим.
ARG AGCTL_VERSION=dev
ARG AGCTL_COMMIT=unknown
ARG AGCTL_BUILD_DATE=
ARG AGCTL_GUEST_API=2
LABEL org.opencontainers.image.title="agctl-dsh-min" \
      org.opencontainers.image.description="Минимальное рабочее место: dsh web и guest agctl" \
      org.opencontainers.image.source="https://github.com/arijjia/agctl" \
      org.opencontainers.image.version="${DSH_VERSION}" \
      org.opencontainers.image.revision="${AGCTL_COMMIT}" \
      org.opencontainers.image.created="${AGCTL_BUILD_DATE}" \
      io.agctl.image.variant="min" \
      io.agctl.dsh.version="${DSH_VERSION}" \
      io.agctl.guest.version="${AGCTL_VERSION}" \
      io.agctl.guest.revision="${AGCTL_COMMIT}" \
      io.agctl.guest.flavor="${GUEST_FLAVOR}" \
      io.agctl.guest.api="${AGCTL_GUEST_API}" \
      io.agctl.no-sshd="${AGCTL_NO_SSHD}"
